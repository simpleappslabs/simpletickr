DB_NAME=simpletickr
DB_USER=simpletickr
DB_PASSWORD=simpletickr

# Optional: override the API base URL seen by the browser. Defaults to the
# relative path "/api", which the reverse proxy (see nginx.conf) forwards to
# the backend — this already works from any hostname/IP that reaches the
# proxy, so you shouldn't need to set this.
# PUBLIC_API_BASE_URL=

# Optional: OIDC single sign-on, additive alongside local login. Leave all three blank to
# keep OIDC off (local login only, the default). Point OIDC_ISSUER_URI at your own IdP
# (Keycloak, Authentik, Authelia, etc.) — simpletickr discovers everything else from its
# /.well-known/openid-configuration document.
# OIDC_ISSUER_URI=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_RP_INITIATED_LOGOUT_ENABLED=false
# The externally reachable URL of the frontend (e.g. the proxy's public origin) — required
# once OIDC is enabled, so simpletickr can redirect back to it after login.
# FRONTEND_BASE_URL=